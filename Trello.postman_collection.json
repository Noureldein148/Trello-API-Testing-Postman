    {
      "name": "Create ToDo list",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set(\"ToDolistID\", pm.response.json().id);\r",
              "\r",
              "const response = pm.response.json();\r",
              "console.log(response)\r",
              "\r",
              "pm.test(\"List name is To Do List\",()=>{\r",
              "    pm.expect(response.name).to.eql(\"To Do List\");\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(\"List is Opened\",()=>{\r",
              "    pm.expect(response.closed).to.eql(false);\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(\"List is inside current boardID\",()=>{\r",
              "    pm.expect(response.idBoard).to.eql(pm.environment.get(\"boardID\"))\r",
              "})\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
