    {
      "name": "Get All Boards",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "for(let i of response){\r",
              "    console.log(i.name)\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/1/members/me/boards?key={{APIkey}}&token={{token}}",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "1",
            "members",
            "me",
            "boards"
          ],
          "query": [
            {
              "key": "key",
              "value": "{{APIkey}}"
            },
            {
              "key": "token",
              "value": "{{token}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create a board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json()\r",
              "const request =    pm.request.url.query;\r",
              "const request_nameBoard =  decodeURIComponent(request.get(\"name\"))\r",
              "\r",
              "pm.environment.set(\"boardID\",response.id)\r",
              "console.log(response)\r",
              "\r",
              "pm.test(\"Status Code is 200\",()=>{\r",
              "    pm.response.to.have.status(200)\r",
              "})\r",
              "\r",
              "pm.environment.set(\"boardID\" , response.id)\r",
              "\r",
              "pm.test(\"Board Name is Correct\",()=>{\r",
              "   pm.expect(response.name).to.eql(request_nameBoard);\r",
              "});\r",
              "\r",
              "pm.test(\"Board is Open\",()=>{\r",
              "    pm.expect(response.closed).to.eql(false);\r",
              "});\r",
              "\r",
              "pm.test(\"Permission is Private\",()=>{\r",
              "    pm.expect(response.prefs.permissionLevel).to.eql(\"private\");\r",
              "});\r",
              "\r",
              "pm.test(\"Calender View is Disabled\",()=>{\r",
              "    pm.expect(response.prefs.switcherViews[2].enabled).to.eql(false);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/1/boards/?name={{$randomFullName}}&key={{APIkey}}&token={{token}}&defaultLists=false",
